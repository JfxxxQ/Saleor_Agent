# ==================== Saleor ====================
SALEOR_API_URL=http://localhost:8000/graphql/
SALEOR_TOKEN=
SALEOR_CHANNEL=default-channel

# ==================== 大模型（OpenAI 兼容接口） ====================
# 主对话模型
LLM_LINE_MODEL=
LLM_BASE_URL=
DASHSCOPE_API_KEY=
# 本地/轻量模型（记忆抽取、摘要、Cypher 生成）
LLM_LOCAL_MODEL=
LOCAL_URL=

# ==================== JWT ====================
JWT_SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== MySQL ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=saleor

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# 窗口记忆保留的消息条数（4 轮 = 8 条）与过期时间（秒）
WINDOW_SIZE=8
WINDOW_TIME=86400

# ==================== ChromaDB / BGE ====================
CHROM_DB_URL=./data/chroma
CHROM_DB_NAME=long_memory
BGE_MODEL_PATH=./models/bge-m3
BGE_DEVICE=cpu
# 长期记忆向量距离阈值，超过该值视为不相关
LONG_MEMORY_MAX_DISTANCE=0.5

# ==================== PostgreSQL ====================
PG_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# ==================== Neo4j ====================
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ==================== Milvus ====================
# 使用本地 Milvus Lite 时填写 .db 路径；
# 使用 docker-compose 启动的 Milvus Standalone 时填写 http://localhost:19530
MILVUS_LOCAL_PATH=./data/milvus_products.db
MILVUS_COLLECTION=products
MILVUS_DIM=1024

# ==================== SMTP 邮箱验证码 ====================
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SENDER=
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true